# Public hostnames (DNS A/AAAA must point to this server for automatic TLS).
# For local testing use: CHAT_DOMAIN=chat.localhost API_DOMAIN=api.localhost (Caddy issues a local CA cert).
CHAT_DOMAIN=chat.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Models to pull on first start (comma-separated). Small CPU-friendly defaults.
OLLAMA_MODELS=qwen2.5:1.5b,nomic-embed-text

# Ollama tuning for CPU-only hosts
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m

# Gateway: SHA-256 hashes of allowed API keys. Generate with:
#   docker compose run --rm gateway python -m app.keygen
API_KEY_HASHES=
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
ALLOWED_MODELS=

# Open WebUI
WEBUI_SECRET_KEY=change-me-long-random
ENABLE_SIGNUP=true
